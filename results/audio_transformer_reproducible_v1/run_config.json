{
  "experiment_name": "aegis_audio_transformer_reproducible_v1",
  "seed": 42,
  "dataset": {
    "index_path": "data/audio_dev/processed/asvspoof2019_la_window_index.csv",
    "cache_path": "data/audio_dev/processed/audio_feature_cache/features.dat",
    "cache_spec_path": "data/audio_dev/processed/audio_feature_cache/cache_spec.json",
    "feature_shape": [
      2,
      128,
      257
    ],
    "cache_dtype": "float16",
    "label_mapping": {
      "bonafide": 0,
      "spoof": 1
    },
    "training_split": "train",
    "validation_split": "dev"
  },
  "model": {
    "in_channels": 2,
    "embed_dim": 128,
    "patch_size": [
      16,
      16
    ],
    "num_heads": 4,
    "num_layers": 4,
    "num_classes": 2,
    "dropout": 0.1
  },
  "training": {
    "batch_size": 16,
    "num_workers": 0,
    "epochs": 5,
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "loss": "CrossEntropyLoss",
    "class_weights": [
      5.0453472,
      0.5550013
    ],
    "gradient_clip_max_norm": 1.0,
    "scheduler": {
      "name": "ReduceLROnPlateau",
      "mode": "min",
      "factor": 0.5,
      "patience": 1
    }
  },
  "safety": {
    "existing_checkpoint": "models/audio_transformer/best_audio_transformer.pt",
    "output_directory": "models/audio_transformer_reproducible_v1",
    "overwrite_existing": false,
    "run_training_automatically": false
  }
}